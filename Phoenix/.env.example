# Phoenix 服務端設定（複製成 Phoenix/.env）。
#
# 讀者只有 docker compose：`docker compose -f Phoenix/compose.yaml up -d`
# 會把 Phoenix/ 當專案目錄、自動讀這個目錄的 .env 做變數替換（已實測）。
#
# ⚠️ 客戶端設定不要放這裡。spider_forge 的 .env loader 只往 cwd 與套件所在位置的
#    「父」目錄搜尋，Phoenix/ 是子目錄，程式永遠讀不到——把
#    PHOENIX_COLLECTOR_ENDPOINT 放這裡的話，追蹤會靜默不啟用。
#    那些變數寫在 **repo 根的 .env**（見根目錄 .env.example 的可觀測性段落）。
#
# 下面全部是 compose.yaml 的內建預設值，不建這份檔也能跑。

# Phoenix 映像版本；想固定版本避免 latest 漂移就改這裡
PHOENIX_IMAGE_TAG=latest

# Web UI + OTLP HTTP 埠（改這個的話，根 .env 的 PHOENIX_COLLECTOR_ENDPOINT 要跟著改）
PHOENIX_UI_PORT=6006
# OTLP gRPC 埠
PHOENIX_GRPC_PORT=4317

# Phoenix 自己的匿名使用統計，本機用先關掉
PHOENIX_TELEMETRY_ENABLED=false

# Phoenix 內建的 MCP server，目前用不到
PHOENIX_ENABLE_MCP_SERVER=false

# Trace 保留天數；0 = 無期限
PHOENIX_RETENTION_DAYS=90
