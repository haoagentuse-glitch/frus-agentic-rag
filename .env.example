# Copy to .env. The real .env is gitignored.

# =========================
# Paths and devices
# =========================
FRUS_DATA_DIR=data
FRUS_RAW_DIR=data/raw/frus/volumes
FRUS_LANCEDB_URI=data/index/lancedb
# Resolve from <hub>/models--BAAI--bge-m3/refs/main; never hard-code the hash in code.
FRUS_BGE_MODEL_PATH=/models/hf-hub/models--BAAI--bge-m3/snapshots/<snapshot>
# cpu for online query embedding, cuda for the offline batch run
FRUS_EMBED_DEVICE=cpu
FRUS_EMBED_BATCH_SIZE=16

# =========================
# Generation
# =========================
FRUS_OLLAMA_HOST=http://ollama:11434
FRUS_OLLAMA_MODEL=qwen3:4b-instruct
FRUS_OLLAMA_NUM_CTX=8192

# =========================
# Observability (Phoenix)
# =========================
# Client-side settings belong HERE, in the repo root .env — not in Phoenix/.env,
# which is only read by `docker compose -f Phoenix/compose.yaml` for the server.
# Leave PHOENIX_COLLECTOR_ENDPOINT unset to disable tracing entirely.
# From the host: http://localhost:6006 ; from a compose service: http://phoenix:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT=frus-agentic-rag
# Set to 1 to force tracing off without unsetting the endpoint.
PHOENIX_DISABLED=

# =========================
# Eval judge (external, optional)
# =========================
# Only used by `frus eval --judge` for answer correctness. Never a source of
# evidence: the corpus stays closed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
